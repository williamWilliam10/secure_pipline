name: Build and Scan Image (reusable)

on:
  workflow_call:

permissions:
  contents: read
  packages: write

jobs:
  build:
    name: Build et Push de l'image
    runs-on: ubuntu-latest
    outputs:
      image-name: ${{ steps.image-name.outputs.name }}
    steps:
      - name: Checkout du code
        uses: actions/checkout@v6

      - name: Connexion à GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Préparer le nom de l'image en minuscule
        id: image-name
        run: echo "name=$(echo '${{ github.repository }}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_OUTPUT"

      - name: Build et Push de l'image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ghcr.io/${{ steps.image-name.outputs.name }}:${{ github.sha }}
            ghcr.io/${{ steps.image-name.outputs.name }}:latest

  image-scan:
    name: Trivy - Scan de l'image construite
    needs: [build]
    runs-on: ubuntu-latest
    steps:
      - name: Connexion à GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Trivy - Scan de l'image
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: ghcr.io/${{ needs.build.outputs.image-name }}:${{ github.sha }}
          severity: CRITICAL,HIGH,MEDIUM,LOW
          exit-code: 0
          format: json
          output: trivy-image-results.json
          ignore-unfixed: true

      - name: Sauvegarder le rapport
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: trivy-image-rapport
          path: trivy-image-results.json

      - name: Vérifier les vulnérabilités bloquantes
        run: |
          CRITICAL_HIGH_COUNT=$(jq '[.Results[]?.Vulnerabilities[]? | select(.Severity == "CRITICAL" or .Severity == "HIGH")] | length' trivy-image-results.json)
          if [ "$CRITICAL_HIGH_COUNT" -gt 0 ]; then
            exit 1
          fi